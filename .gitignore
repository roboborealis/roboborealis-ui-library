# Dependencies
node_modules/
# Nested app node_modules — designer has its own package.json;
# its node_modules must never be committed (and a future npm install there
# would reinstall Storybook v8 packages that conflict with the root v10 setup)
designer/node_modules/
designer/.node_modules*/
capture/node_modules/
.pnp
.pnp.js

# Testing
coverage/
.nyc_output/

# Production builds
build/
dist/
.next/
out/

# npm pack tarballs (from the `npm run build:lib && npm pack` local consumer-testing flow)
*.tgz

# Generated by scripts/copy-fonts.ts — derived from node_modules/@fontsource/*
fonts/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Worktrees
.worktrees/

# Playwright MCP logs
.playwright-mcp/

# Temporary files
*.tmp
.cache/
.parcel-cache/

# Debug / verification screenshots (generated during development, not tracked)
*.png
!src/brand/assets/*.png

# OS files
Thumbs.db

# Storybook build output
storybook-static/

# Test output
junit.xml

# OpenTofu / Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
*.plan
.terraform.lock.hcl
crash.log

# Storybook capture
capture/scripts/*.yml
.superpowers/
